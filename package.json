{
  "name": "cicd-rfc-assistant",
  "version": "0.1.2",
  "private": true,
  "description": "Desktop assistant for OIC CI/CD RFC package preparation.",
  "author": "CSS Team Mex / EU",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on tcp:5173 && node scripts/start-electron-dev.cjs\"",
    "build": "tsc && vite build && tsc -p electron/tsconfig.json && node scripts/copy-preload.cjs",
    "verify": "npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder --mac --win --linux",
    "release:build": "npm run build && electron-builder --mac --win --linux --publish never"
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.545.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "wait-on": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.bimbo.cicd.rfcassistant",
    "productName": "CICD Assistant",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://cicd-rfc-converters-updates.geovani-cicd-rfc.workers.dev/app"
      }
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/icon.icns",
      "extendInfo": {
        "CFBundleDisplayName": "CI/CD Assistant"
      }
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}
